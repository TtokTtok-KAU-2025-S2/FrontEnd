<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/main_background">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- 뒤로가기 버튼 -->
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_margin="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_left"
            android:contentDescription="뒤로가기"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- 제목 -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="알림 설정"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginStart="8dp"
            app:layout_constraintStart_toEndOf="@id/btnBack"
            app:layout_constraintTop_toTopOf="@id/btnBack"
            app:layout_constraintBottom_toBottomOf="@id/btnBack" />

        <!-- 저장 버튼 -->
        <androidx.cardview.widget.CardView
            android:id="@+id/btnSave"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#6A5ACD"
            android:clickable="true"
            android:foreground="?attr/selectableItemBackground"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="저장"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp" />

        </androidx.cardview.widget.CardView>

        <!-- 전체 알림 설정 카드 -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardAllNotifications"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            app:cardBackgroundColor="#6A5ACD"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:layout_constraintTop_toBottomOf="@id/btnBack">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp">

                <androidx.cardview.widget.CardView
                    android:id="@+id/bellIconContainer"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#6A5ACD"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent">

                    <ImageView
                        android:id="@+id/ivBellIcon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_bell" />

                </androidx.cardview.widget.CardView>

                <TextView
                    android:id="@+id/tvAllNotificationsTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="모든 알림"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginStart="12dp"
                    app:layout_constraintStart_toEndOf="@id/bellIconContainer"
                    app:layout_constraintTop_toTopOf="@id/bellIconContainer"
                    app:layout_constraintBottom_toBottomOf="@id/bellIconContainer"
                    app:layout_constraintEnd_toStartOf="@id/switchAllNotifications" />

                <TextView
                    android:id="@+id/tvAllNotificationsDesc"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="모든 알림을 받고 있습니다"
                    android:textColor="#B8B3E6"
                    android:textSize="14sp"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="4dp"
                    app:layout_constraintStart_toEndOf="@id/bellIconContainer"
                    app:layout_constraintTop_toBottomOf="@id/tvAllNotificationsTitle"
                    app:layout_constraintEnd_toStartOf="@id/switchAllNotifications" />

                <Switch
                    android:id="@+id/switchAllNotifications"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.cardview.widget.CardView>

        <!-- 카테고리 제목 -->
        <TextView
            android:id="@+id/tvCategoryTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="알림 카테고리"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginStart="16dp"
            android:layout_marginTop="24dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardAllNotifications" />

        <TextView
            android:id="@+id/tvCategoryDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="받고 싶은 알림을 선택하세요"
            android:textColor="#B8B3E6"
            android:textSize="14sp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="4dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvCategoryTitle" />

        <!-- 똑똑 공동 탐색 카테고리 -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardNoiseDetection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="#6A5ACD"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:layout_constraintTop_toBottomOf="@id/tvCategoryDesc">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">

                <androidx.cardview.widget.CardView
                    android:id="@+id/noiseIconContainer"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#6A5ACD"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_volume_up" />

                </androidx.cardview.widget.CardView>

                <TextView
                    android:id="@+id/tvNoiseTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="똑똑 공동 탐색"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginStart="12dp"
                    app:layout_constraintStart_toEndOf="@id/noiseIconContainer"
                    app:layout_constraintTop_toTopOf="@id/noiseIconContainer"
                    app:layout_constraintBottom_toBottomOf="@id/noiseIconContainer"
                    app:layout_constraintEnd_toStartOf="@id/switchNoise" />

                <TextView
                    android:id="@+id/tvNoiseDesc"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="탐색 요청 및 응답 알림"
                    android:textColor="#B8B3E6"
                    android:textSize="12sp"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="2dp"
                    app:layout_constraintStart_toEndOf="@id/noiseIconContainer"
                    app:layout_constraintTop_toBottomOf="@id/tvNoiseTitle"
                    app:layout_constraintEnd_toStartOf="@id/switchNoise" />

                <Switch
                    android:id="@+id/switchNoise"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.cardview.widget.CardView>

        <!-- 사전 양해 카테고리 -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardPriorConsent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="8dp"
            app:cardBackgroundColor="#6A5ACD"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:layout_constraintTop_toBottomOf="@id/cardNoiseDetection">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">

                <androidx.cardview.widget.CardView
                    android:id="@+id/heartIconContainer"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#6A5ACD"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_favorite" />

                </androidx.cardview.widget.CardView>

                <TextView
                    android:id="@+id/tvHeartTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="사전 양해"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginStart="12dp"
                    app:layout_constraintStart_toEndOf="@id/heartIconContainer"
                    app:layout_constraintTop_toTopOf="@id/heartIconContainer"
                    app:layout_constraintBottom_toBottomOf="@id/heartIconContainer"
                    app:layout_constraintEnd_toStartOf="@id/switchHeart" />

                <TextView
                    android:id="@+id/tvHeartDesc"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="이웃의 사전 양해 알림"
                    android:textColor="#B8B3E6"
                    android:textSize="12sp"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="2dp"
                    app:layout_constraintStart_toEndOf="@id/heartIconContainer"
                    app:layout_constraintTop_toBottomOf="@id/tvHeartTitle"
                    app:layout_constraintEnd_toStartOf="@id/switchHeart" />

                <Switch
                    android:id="@+id/switchHeart"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.cardview.widget.CardView>

        <!-- 게시판 카테고리 -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardComments"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="8dp"
            app:cardBackgroundColor="#6A5ACD"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:layout_constraintTop_toBottomOf="@id/cardPriorConsent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">

                <androidx.cardview.widget.CardView
                    android:id="@+id/messageIconContainer"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#6A5ACD"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_message" />

                </androidx.cardview.widget.CardView>

                <TextView
                    android:id="@+id/tvMessageTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="게시판"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginStart="12dp"
                    app:layout_constraintStart_toEndOf="@id/messageIconContainer"
                    app:layout_constraintTop_toTopOf="@id/messageIconContainer"
                    app:layout_constraintBottom_toBottomOf="@id/messageIconContainer"
                    app:layout_constraintEnd_toStartOf="@id/switchMessage" />

                <TextView
                    android:id="@+id/tvMessageDesc"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="댓글 및 답글 알림"
                    android:textColor="#B8B3E6"
                    android:textSize="12sp"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="2dp"
                    app:layout_constraintStart_toEndOf="@id/messageIconContainer"
                    app:layout_constraintTop_toBottomOf="@id/tvMessageTitle"
                    app:layout_constraintEnd_toStartOf="@id/switchMessage" />

                <Switch
                    android:id="@+id/switchMessage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.cardview.widget.CardView>

        <!-- 관리사무소 공지 카테고리 -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardAnnouncements"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="8dp"
            app:cardBackgroundColor="#6A5ACD"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:layout_constraintTop_toBottomOf="@id/cardComments">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">

                <androidx.cardview.widget.CardView
                    android:id="@+id/buildingIconContainer"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#6A5ACD"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_building" />

                </androidx.cardview.widget.CardView>

                <TextView
                    android:id="@+id/tvBuildingTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="관리사무소 공지"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginStart="12dp"
                    app:layout_constraintStart_toEndOf="@id/buildingIconContainer"
                    app:layout_constraintTop_toTopOf="@id/buildingIconContainer"
                    app:layout_constraintBottom_toBottomOf="@id/buildingIconContainer"
                    app:layout_constraintEnd_toStartOf="@id/switchBuilding" />

                <TextView
                    android:id="@+id/tvBuildingDesc"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="중요 공지사항 알림"
                    android:textColor="#B8B3E6"
                    android:textSize="12sp"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="2dp"
                    app:layout_constraintStart_toEndOf="@id/buildingIconContainer"
                    app:layout_constraintTop_toBottomOf="@id/tvBuildingTitle"
                    app:layout_constraintEnd_toStartOf="@id/switchBuilding" />

                <Switch
                    android:id="@+id/switchBuilding"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.cardview.widget.CardView>

        <!-- 방해금지 시간 설정 카드 -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardDoNotDisturb"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="#6A5ACD"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:layout_constraintTop_toBottomOf="@id/cardAnnouncements">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp">

                <androidx.cardview.widget.CardView
                    android:id="@+id/moonIconContainer"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#6A5ACD"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_moon" />

                </androidx.cardview.widget.CardView>

                <TextView
                    android:id="@+id/tvDoNotDisturbTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="방해금지 시간"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginStart="12dp"
                    app:layout_constraintStart_toEndOf="@id/moonIconContainer"
                    app:layout_constraintTop_toTopOf="@id/moonIconContainer"
                    app:layout_constraintBottom_toBottomOf="@id/moonIconContainer"
                    app:layout_constraintEnd_toEndOf="parent" />

                <TextView
                    android:id="@+id/tvDoNotDisturbDesc"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="지정한 시간에는 알림을 받지 않습니다"
                    android:textColor="#B8B3E6"
                    android:textSize="14sp"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="4dp"
                    app:layout_constraintStart_toEndOf="@id/moonIconContainer"
                    app:layout_constraintTop_toBottomOf="@id/tvDoNotDisturbTitle"
                    app:layout_constraintEnd_toEndOf="parent" />

                <!-- 시작 시간 -->
                <TextView
                    android:id="@+id/tvStartTimeLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="시작 시간"
                    android:textColor="#B8B3E6"
                    android:textSize="14sp"
                    android:layout_marginStart="44dp"
                    android:layout_marginTop="16dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvDoNotDisturbDesc" />

                <androidx.cardview.widget.CardView
                    android:id="@+id/startTimeContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#6A5ACD"
                    android:clickable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/tvStartTimeLabel"
                    app:layout_constraintBottom_toBottomOf="@id/tvStartTimeLabel">

                    <TextView
                        android:id="@+id/tvStartTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="22:00"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="8dp" />

                </androidx.cardview.widget.CardView>

                <!-- 종료 시간 -->
                <TextView
                    android:id="@+id/tvEndTimeLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="종료 시간"
                    android:textColor="#B8B3E6"
                    android:textSize="14sp"
                    android:layout_marginStart="44dp"
                    android:layout_marginTop="12dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/startTimeContainer" />

                <androidx.cardview.widget.CardView
                    android:id="@+id/endTimeContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#6A5ACD"
                    android:clickable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/tvEndTimeLabel"
                    app:layout_constraintBottom_toBottomOf="@id/tvEndTimeLabel">

                    <TextView
                        android:id="@+id/tvEndTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="07:00"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="8dp" />

                </androidx.cardview.widget.CardView>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>
