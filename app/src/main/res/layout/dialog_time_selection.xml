<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#FFFFFF">

    <!-- 단계 인디케이터 -->
    <LinearLayout
        android:id="@+id/llStepIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_gravity="end"
        android:layout_marginBottom="16dp">

        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="#2563EB"
            android:layout_marginEnd="4dp" />

        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="#E5E7EB"
            android:layout_marginEnd="4dp" />

        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="#E5E7EB"
            android:layout_marginEnd="4dp" />

        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="#E5E7EB" />

    </LinearLayout>

    <!-- 타이틀 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_clock_blue" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1. 시간 선택"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#1F2937"
            android:layout_marginStart="8dp" />

    </LinearLayout>

    <!-- 설명 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="소음이 발생한 시간을 선택해주세요"
        android:textSize="14sp"
        android:textColor="#6B7280"
        android:layout_marginBottom="16dp" />

    <!-- 선택된 날짜 표시 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#EFF6FF"
        android:padding="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="20dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_calendar_blue" />

        <TextView
            android:id="@+id/tvSelectedDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2025. 10. 27."
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#1E3A8A"
            android:layout_marginStart="8dp"
            tools:text="2025. 10. 27." />

    </LinearLayout>

    <!-- 시간 선택 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="시간 선택"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#374151"
        android:layout_marginBottom="8dp" />

    <Spinner
        android:id="@+id/spinnerTime"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="#F9FAFB"
        android:layout_marginBottom="24dp" />

    <!-- 버튼 영역 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <Button
            android:id="@+id/btnCancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="취소"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:textColor="#6B7280"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnNext"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="다음"
            android:backgroundTint="#2563EB"
            android:textColor="#FFFFFF"
            android:enabled="false" />

    </LinearLayout>

</LinearLayout>
