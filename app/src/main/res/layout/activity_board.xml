<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F3FF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 헤더 영역 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#F5F3FF"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:elevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- 뒤로가기 -->
                <TextView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:text="←"
                    android:textSize="20sp"
                    android:gravity="center"
                    android:textColor="#030213"
                    android:background="?attr/selectableItemBackgroundBorderless"/>

                <!-- 제목 -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="우리 아파트 게시판"
                        android:textSize="20sp"
                        android:textColor="#030213"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="-0.01"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="이웃과 소통하고 정보를 공유하세요"
                        android:textSize="13sp"
                        android:textColor="#717182"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>

                <!-- 추가 버튼 -->
                <TextView
                    android:id="@+id/addButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:text="+"
                    android:textSize="24sp"
                    android:gravity="center"
                    android:textColor="#030213"
                    android:background="?attr/selectableItemBackgroundBorderless"/>
            </LinearLayout>

            <!-- 검색바 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="#F3F3F5"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginTop="16dp">

                <TextView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:text="⌕"
                    android:textSize="16sp"
                    android:textColor="#717182"
                    android:gravity="center"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="게시글 검색..."
                    android:textColor="#717182"
                    android:textSize="14sp"
                    android:layout_marginStart="12dp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- 카테고리 필터 -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:paddingTop="16dp"
            android:paddingBottom="12dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:background="@drawable/card_background">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- 전체 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="전체"
                    android:textColor="#FFFFFF"
                    android:background="#030213"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:gravity="center"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginEnd="8dp"/>

                <!-- 관리사무소 공지 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="관리사무소 공지"
                    android:textColor="#030213"
                    android:background="#F3F3F5"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:gravity="center"
                    android:textSize="14sp"
                    android:layout_marginEnd="8dp"/>

                <!-- 주민 소통 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="주민 소통"
                    android:textColor="#030213"
                    android:background="#F3F3F5"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:gravity="center"
                    android:textSize="14sp"
                    android:layout_marginEnd="8dp"/>

                <!-- 시설 관리 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="시설 관리"
                    android:textColor="#030213"
                    android:background="#F3F3F5"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:gravity="center"
                    android:textSize="14sp"
                    android:layout_marginEnd="8dp"/>

                <!-- 긴급/중요 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="긴급/중요"
                    android:textColor="#D4183D"
                    android:background="#FFEBEF"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:gravity="center"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium"/>
            </LinearLayout>
        </HorizontalScrollView>

        <!-- 컨텐츠 영역 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="20dp">

            <!-- 긴급 공지 카드 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_background"
                android:orientation="vertical"
                android:padding="20dp"
                android:elevation="1dp"
                android:layout_marginBottom="16dp">

                <!-- 카테고리 배지 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="24dp"
                        android:text="긴급/중요"
                        android:textColor="#D4183D"
                        android:background="#FFEBEF"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:gravity="center"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-medium"/>

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="6시간 전"
                        android:textColor="#CBCED4"
                        android:textSize="12sp"/>
                </LinearLayout>

                <!-- 제목 -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="지하주차장 CCTV 점검으로 인한 일시 출입 제한"
                    android:textColor="#030213"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-medium"
                    android:lineSpacingExtra="2dp"
                    android:layout_marginBottom="8dp"/>

                <!-- 내용 미리보기 -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="오늘 오후 2-4시 지하주차장 CCTV 점검 예정"
                    android:textColor="#717182"
                    android:textSize="14sp"
                    android:lineSpacingExtra="2dp"
                    android:layout_marginBottom="12dp"/>

                <!-- 작성자 정보 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="보안팀"
                    android:textColor="#717182"
                    android:textSize="13sp"/>
            </LinearLayout>

            <!-- 최근 게시글 헤더 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="최근 게시글"
                    android:textSize="16sp"
                    android:textColor="#030213"
                    android:fontFamily="sans-serif-medium"/>

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5개"
                    android:textSize="14sp"
                    android:textColor="#717182"/>
            </LinearLayout>

            <!-- 일반 게시글 카드 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_background"
                android:orientation="vertical"
                android:padding="20dp"
                android:elevation="1dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="24dp"
                        android:text="관리사무소"
                        android:textColor="#030213"
                        android:background="#E9EBEF"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:gravity="center"
                        android:textSize="12sp"/>

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="6시간 전"
                        android:textColor="#CBCED4"
                        android:textSize="12sp"/>
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="12월 관리비 안내 및 난방비 절약을 위한 안내드립니다"
                    android:textColor="#030213"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-medium"
                    android:lineSpacingExtra="2dp"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="겨울철 난방비 절약을 위한 안내드립니다."
                    android:textColor="#717182"
                    android:textSize="14sp"
                    android:lineSpacingExtra="2dp"
                    android:layout_marginBottom="12dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="관리사무소"
                        android:textColor="#717182"
                        android:textSize="13sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="조회 124"
                        android:textColor="#CBCED4"
                        android:textSize="12sp"
                        android:layout_marginStart="12dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="댓글 3"
                        android:textColor="#CBCED4"
                        android:textSize="12sp"
                        android:layout_marginStart="12dp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- 일반 게시글 카드 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_background"
                android:orientation="vertical"
                android:padding="20dp"
                android:elevation="1dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="24dp"
                        android:text="주민 소통"
                        android:textColor="#030213"
                        android:background="#E9EBEF"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:gravity="center"
                        android:textSize="12sp"/>

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="12시간 전"
                        android:textColor="#CBCED4"
                        android:textSize="12sp"/>
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="단지 내 반려동물 산책 시간 조정 건의"
                    android:textColor="#030213"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-medium"
                    android:lineSpacingExtra="2dp"
                    android:layout_marginBottom="12dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="102동 주민"
                        android:textColor="#717182"
                        android:textSize="13sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="조회 89"
                        android:textColor="#CBCED4"
                        android:textSize="12sp"
                        android:layout_marginStart="12dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="댓글 12"
                        android:textColor="#CBCED4"
                        android:textSize="12sp"
                        android:layout_marginStart="12dp"/>
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</ScrollView>