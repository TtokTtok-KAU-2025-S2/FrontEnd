<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="#F9FAFB">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <!-- 시간 표시 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:background="#E0E7FF"
            android:padding="8dp"
            android:layout_marginEnd="12dp">

            <TextView
                android:id="@+id/tvRecordTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="14:30"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#4338CA"
                tools:ignore="HardcodedText" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="시간"
                android:textSize="11sp"
                android:textColor="#6366F1"
                tools:ignore="HardcodedText,SmallSp" />

        </LinearLayout>

        <!-- 기록 정보 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvRecordCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="생활소음"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#1F2937"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/tvRecordIntensity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="강도: 3.5"
                android:textSize="12sp"
                android:textColor="#6B7280"
                android:layout_marginTop="4dp"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/tvRecordMemo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="윗집 발소리가 심함"
                android:textSize="12sp"
                android:textColor="#9CA3AF"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:ellipsize="end"
                tools:ignore="HardcodedText" />

        </LinearLayout>

        <!-- 화살표 아이콘 -->
        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_arrow_right"
            android:contentDescription="@string/view_detail" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
