<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:maxHeight="500dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:background="#FFFFFF">

        <!-- 단계 인디케이터 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_gravity="end"
            android:layout_marginBottom="16dp">

            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="#2563EB"
                android:layout_marginEnd="4dp" />

            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="#2563EB"
                android:layout_marginEnd="4dp" />

            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="#2563EB"
                android:layout_marginEnd="4dp" />

            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="#E5E7EB" />

        </LinearLayout>

        <!-- 타이틀 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_tag_purple"
                android:contentDescription="@string/tag_icon" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/category_step_title"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#1F2937"
                android:layout_marginStart="8dp" />

        </LinearLayout>

        <!-- 설명 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/category_description"
            android:textSize="14sp"
            android:textColor="#6B7280"
            android:layout_marginBottom="20dp" />

        <!-- 카테고리 목록 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/category_label"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#374151"
            android:layout_marginBottom="12dp" />

        <!-- 생활소음 -->
        <LinearLayout
            android:id="@+id/llLivingNoise"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#F9FAFB"
            android:padding="16dp"
            android:layout_marginBottom="8dp"
            android:clickable="true"
            android:focusable="true">

            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="#DBEAFE">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_home_blue"
                    android:layout_gravity="center"
                    android:contentDescription="@string/living_noise" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/living_noise"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#1F2937" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/living_noise_desc"
                    android:textSize="14sp"
                    android:textColor="#6B7280"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

            <View
                android:id="@+id/livingNoiseCheck"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="#E5E7EB"
                android:visibility="invisible" />

        </LinearLayout>

        <!-- 애완동물 소음 -->
        <LinearLayout
            android:id="@+id/llPetNoise"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#F9FAFB"
            android:padding="16dp"
            android:layout_marginBottom="8dp"
            android:clickable="true"
            android:focusable="true">

            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="#FCE7F3">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_heart_pink"
                    android:layout_gravity="center"
                    android:contentDescription="@string/pet_noise" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pet_noise"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#1F2937" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pet_noise_desc"
                    android:textSize="14sp"
                    android:textColor="#6B7280"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

            <View
                android:id="@+id/petNoiseCheck"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="#E5E7EB"
                android:visibility="invisible" />

        </LinearLayout>

        <!-- 기계 소음 -->
        <LinearLayout
            android:id="@+id/llMachineNoise"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#F9FAFB"
            android:padding="16dp"
            android:layout_marginBottom="8dp"
            android:clickable="true"
            android:focusable="true">

            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="#F3F4F6">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_settings_gray"
                    android:layout_gravity="center"
                    android:contentDescription="@string/machine_noise" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/machine_noise"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#1F2937" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/machine_noise_desc"
                    android:textSize="14sp"
                    android:textColor="#6B7280"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

            <View
                android:id="@+id/machineNoiseCheck"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="#E5E7EB"
                android:visibility="invisible" />

        </LinearLayout>

        <!-- 기타 소음 -->
        <LinearLayout
            android:id="@+id/llOtherNoise"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#F9FAFB"
            android:padding="16dp"
            android:layout_marginBottom="24dp"
            android:clickable="true"
            android:focusable="true">

            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="#FEF3C7">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_more_yellow"
                    android:layout_gravity="center"
                    android:contentDescription="@string/other_noise" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/other_noise"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#1F2937" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/other_noise_desc"
                    android:textSize="14sp"
                    android:textColor="#6B7280"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

            <View
                android:id="@+id/otherNoiseCheck"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="#E5E7EB"
                android:visibility="invisible" />

        </LinearLayout>

        <!-- 버튼 영역 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end">

            <Button
                android:id="@+id/btnPrevious"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_previous"
                style="@style/Widget.AppCompat.Button.Borderless"
                android:textColor="#6B7280"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnCancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_cancel"
                style="@style/Widget.AppCompat.Button.Borderless"
                android:textColor="#6B7280"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnNext"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_next"
                android:backgroundTint="#2563EB"
                android:textColor="#FFFFFF"
                android:enabled="false" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
