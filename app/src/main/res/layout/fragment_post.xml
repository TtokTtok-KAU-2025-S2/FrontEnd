<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F3FF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- 🔹 상단 헤더 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="16dp">

            <!-- 뒤로가기 -->
            <TextView
                android:id="@+id/backButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:text="←"
                android:textSize="20sp"
                android:gravity="center"
                android:textColor="#030213"
                android:background="?attr/selectableItemBackgroundBorderless" />

            <!-- 제목 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="새 글 작성"
                android:textSize="18sp"
                android:textColor="#030213"
                android:gravity="center"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <!-- 구분선 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0"
            android:layout_marginBottom="20dp" />

        <!-- 🔹 카테고리 선택 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="카테고리 선택"
            android:textSize="14sp"
            android:textColor="#717182"
            android:layout_marginBottom="8dp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/category_notice"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="관리사무소 공지"
                    android:textColor="#030213"
                    android:background="#F3F3F5"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:gravity="center"
                    android:textSize="14sp"
                    android:layout_marginEnd="8dp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/category_community"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="주민 소통"
                    android:textColor="#030213"
                    android:background="#F3F3F5"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:gravity="center"
                    android:textSize="14sp"
                    android:layout_marginEnd="8dp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/category_suggestion"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="민원 및 건의사항"
                    android:textColor="#030213"
                    android:background="#F3F3F5"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:gravity="center"
                    android:textSize="14sp"
                    android:layout_marginEnd="8dp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/category_facility"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="시설 관리"
                    android:textColor="#030213"
                    android:background="#F3F3F5"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:gravity="center"
                    android:textSize="14sp"
                    android:layout_marginEnd="8dp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/category_emergency"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="긴급/중요"
                    android:textColor="#D4183D"
                    android:background="#FFEBEF"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:gravity="center"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- 🔹 제목 입력 -->
        <EditText
            android:id="@+id/editTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="제목을 입력하세요"
            android:textColor="#030213"
            android:textSize="16sp"
            android:background="@drawable/card_background"
            android:padding="16dp"
            android:layout_marginBottom="12dp" />

        <!-- 🔹 내용 입력 -->
        <EditText
            android:id="@+id/editContent"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:hint="내용을 입력하세요"
            android:textColor="#030213"
            android:textSize="15sp"
            android:gravity="top"
            android:inputType="textMultiLine"
            android:background="@drawable/card_background"
            android:padding="16dp"
            android:overScrollMode="always"
            android:scrollbars="vertical" />

        <!-- 🔹 등록 버튼 -->
        <TextView
            android:id="@+id/submitButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="등록하기"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:fontFamily="sans-serif-medium"
            android:background="#4B33FF"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="30dp" />
    </LinearLayout>
</ScrollView>
