<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:background="?attr/selectableItemBackground">

    <!-- 재생 버튼 -->
    <ImageButton
        android:id="@+id/btnPlay"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="center_vertical"
        android:src="@android:drawable/ic_media_play"
        android:background="@drawable/bg_badge_green"
        android:padding="10dp"
        android:contentDescription="재생" />

    <!-- 정보 영역 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:layout_gravity="center_vertical"
        android:orientation="vertical">

        <!-- 파일명 -->
        <TextView
            android:id="@+id/tvFileName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="noise_123456.m4a"
            android:textColor="@android:color/black"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- 날짜 및 시간 -->
        <TextView
            android:id="@+id/tvCreatedAt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="2025-11-26 23:05"
            android:textColor="@android:color/darker_gray"
            android:textSize="12sp" />

        <!-- dB 정보 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⏱ 20초"
                android:textColor="@android:color/darker_gray"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvDbInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="📊 최대 30dB / 평균 15dB"
                android:textColor="@android:color/darker_gray"
                android:textSize="11sp" />

        </LinearLayout>

    </LinearLayout>

    <!-- 다운로드 버튼 -->
    <ImageButton
        android:id="@+id/btnDownload"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="8dp"
        android:src="@android:drawable/stat_sys_download"
        android:background="@drawable/bg_badge_blue"
        android:padding="10dp"
        android:contentDescription="다운로드" />

</LinearLayout>

