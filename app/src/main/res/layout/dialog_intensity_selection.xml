<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#FFFFFF">

    <!-- 단계 인디케이터 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_gravity="end"
        android:layout_marginBottom="16dp">

        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="#2563EB"
            android:layout_marginEnd="4dp" />

        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="#2563EB"
            android:layout_marginEnd="4dp" />

        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="#E5E7EB"
            android:layout_marginEnd="4dp" />

        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="#E5E7EB" />

    </LinearLayout>

    <!-- 타이틀 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_chart_orange" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2. 소음 강도"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#1F2937"
            android:layout_marginStart="8dp" />

    </LinearLayout>

    <!-- 설명 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="소음의 강도를 1-5단계로 선택해주세요"
        android:textSize="14sp"
        android:textColor="#6B7280"
        android:layout_marginBottom="32dp" />

    <!-- 강도 선택 영역 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="소음 강도 (1~5단계)"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#374151"
        android:layout_marginBottom="16dp" />

    <!-- 강도 선택 버튼들 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/btnIntensity1"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="1"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#16A34A"
            android:background="#DCFCE7"
            android:gravity="center"
            android:layout_marginEnd="4dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btnIntensity2"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="2"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#65A30D"
            android:background="#F7FEE7"
            android:gravity="center"
            android:layout_marginEnd="4dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btnIntensity3"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="3"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#D97706"
            android:background="#FEF3C7"
            android:gravity="center"
            android:layout_marginEnd="4dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btnIntensity4"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="4"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#EA580C"
            android:background="#FED7AA"
            android:gravity="center"
            android:layout_marginEnd="4dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btnIntensity5"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="5"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#DC2626"
            android:background="#FECACA"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

    <!-- 강도 설명 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="24dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="1 매우 작음"
            android:textSize="10sp"
            android:textColor="#6B7280"
            android:gravity="center" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="3 보통"
            android:textSize="10sp"
            android:textColor="#6B7280"
            android:gravity="center" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="5 매우 큼"
            android:textSize="10sp"
            android:textColor="#6B7280"
            android:gravity="center" />

    </LinearLayout>

    <!-- 선택된 강도 표시 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="24dp">

        <TextView
            android:id="@+id/tvSelectedIntensity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1단계 - 매우 작음"
            android:textColor="#16A34A"
            android:background="#DCFCE7"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:visibility="gone" />

    </LinearLayout>

    <!-- 버튼 영역 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <Button
            android:id="@+id/btnPrevious"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="이전"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:textColor="#6B7280"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnCancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="취소"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:textColor="#6B7280"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnNext"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="다음"
            android:backgroundTint="#2563EB"
            android:textColor="#FFFFFF"
            android:enabled="false" />

    </LinearLayout>

</LinearLayout>
